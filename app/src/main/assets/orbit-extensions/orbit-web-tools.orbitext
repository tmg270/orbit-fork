{
  "schemaVersion": 1,
  "id": "com.orbit.extensions.web-tools",
  "name": "GrokLink Links",
  "version": "1.0.1",
  "author": "GrokLink",
  "description": "Quick access to GrokLink's builds and source, and to Grok on the web.",
  "actions": [
    {
      "id": "open-orbit-releases",
      "name": "Open GrokLink builds",
      "description": "Opens the GitHub page where new GrokLink builds are published.",
      "type": "open_url",
      "url": "https://github.com/tmg270/orbit-fork/actions/workflows/build-apk.yml"
    },
    {
      "id": "open-orbit-repository",
      "name": "Open GrokLink source",
      "description": "Opens the GrokLink source repository.",
      "type": "open_url",
      "url": "https://github.com/tmg270/orbit-fork"
    },
    {
      "id": "open-orbit-issues",
      "name": "Open Grok on the web",
      "description": "Opens grok.com.",
      "type": "open_url",
      "url": "https://grok.com"
    }
  ]
}
